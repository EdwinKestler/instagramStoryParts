{
  "name": "instagram-story-parts-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "rollup": "npm:@rollup/wasm-node@^4.63.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
